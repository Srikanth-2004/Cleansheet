# Local AWS access. Use your authorised AWS CLI profile or its default profile.
AWS_REGION=ap-south-1
# AWS_PROFILE=
# If the event provides temporary credentials, use all three in place of AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Required by the backend and demo seed. Use the DynamoTable output from the stack.
CLEANSHEET_DYNAMODB_TABLE=
CLEANSHEET_SCENARIO_ID=smoke

# Required by seed:demo. Use Cognito user sub values and an approved sandbox contact.
CLEANSHEET_COACH_SUB=
CLEANSHEET_PARENT_SUB=
CLEANSHEET_TEST_PARENT_EMAIL=
CLEANSHEET_TEST_PARENT_PHONE=

# Optional for the core API. Required for local Secure ID Sandbox testing.
# On Lambda, configure these through SecureIdSecretArn in the SAM stack.
CASHFREE_SECURE_ID_CLIENT_ID=
CASHFREE_SECURE_ID_CLIENT_SECRET=
