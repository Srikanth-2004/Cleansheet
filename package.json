{
  "name": "cleansheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "config:check": "node --env-file-if-exists=.env scripts/check-config.mjs",
    "dev": "next dev",
    "web:build": "next build",
    "web:start": "next start",
    "web:typecheck": "tsc -p tsconfig.web.json --noEmit",
    "smoke:sarvam": "node --env-file-if-exists=.env scripts/smoke-sarvam.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "firebase": "^11.0.0",
    "motion": "^14.14.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sarvamai": "^1.1.21",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
