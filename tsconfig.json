{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "aws-lambda"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/app/**",
    "src/components/**",
    "src/lib/client/**",
    "src/lib/server/firebase-*.ts",
    "src/middleware.ts"
  ]
}
