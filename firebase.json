{
  "functions": {
    "source": "functions",
    "runtime": "nodejs26",
    "ignore": ["node_modules", ".git", "*.local", ".env.example", "test", "scripts", "firebase-debug.log"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "firestore": { "rules": "firestore.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
